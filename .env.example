# ============================================================
# LEX FLOW — CONFIGURAÇÕES DE AMBIENTE E PRODUÇÃO (VERCEL & SUPABASE)
# ============================================================

# PORTA DO SERVIDOR (Node.js / Cloud Run / Dev)
PORT=3000

# URLS DOS PROJETOS NA VERCEL
# Backend API (Projeto Vercel: lex-flow):
API_URL="https://lex-flow-steel.vercel.app"
# Frontend Dashboard (Projeto Vercel: lex-flow-dashboard):
APP_URL="https://lex-flow-dashboard.vercel.app"

# ============================================================
# SUPABASE (BANCO DE DADOS POSTGRESQL & MULTI-TENANCY)
# Execute o script supabase/schema.sql no SQL Editor do Supabase
# ============================================================
SUPABASE_URL="https://seu-projeto.supabase.co"
SUPABASE_ANON_KEY="sua_chave_anonima_publica_supabase"
SUPABASE_SERVICE_ROLE_KEY="sua_chave_service_role_secreta_supabase"

# ============================================================
# GOOGLE GEMINI API (Para o Agente de IA do plano LEX FLOW IA)
# ============================================================
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-2.5-flash"

# ============================================================
# EFÍ BANK (PIX OFICIAL — GERENCIANET)
# Documentação oficial: https://dev.efipay.com.br/docs/api-pix/
# ============================================================
EFI_ENV="sandbox" # Altere para "producao" em ambiente produtivo
EFI_CLIENT_ID="seu_client_id_efi"
EFI_CLIENT_SECRET="seu_client_secret_efi"
EFI_PIX_KEY="financeiro@lexflow.com.br"
EFI_CERT_PATH="./certs/producao.p12"
EFI_WEBHOOK_SECRET="lexflow_pix_webhook_secret_key"

# ============================================================
# WHATSAPP BUSINESS PLATFORM (META GRAPH API)
# Documentação: https://developers.facebook.com/docs/whatsapp/cloud-api
# ============================================================
WHATSAPP_VERIFY_TOKEN="lexflow_meta_verify_token_secure"
WHATSAPP_API_TOKEN="EAAG..."
WHATSAPP_PHONE_NUMBER_ID="10987654321"
WHATSAPP_WABA_ID="1234567890"

# ============================================================
# AUTENTICAÇÃO E SEGURANÇA
# ============================================================
JWT_SECRET="lexflow_super_secret_jwt_key_2026"
ADMIN_SECRET_KEY="lexflow_admin_master_secret"
